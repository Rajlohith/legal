# Copy this file to .env and fill in the values you need.
# .env is only read by the web backend (web.py / backend/server.py) --
# the desktop GUI (main.py) doesn't use it.

# ------------------------------------------------------------------
# LLM provider for the "Describe your search" AI-fill feature.
# Set LLM_PROVIDER to "gemini" or "openai" and fill in the matching
# keys below. Only the selected provider's key is required.
# ------------------------------------------------------------------

LLM_PROVIDER=gemini

# -- Gemini (https://aistudio.google.com/apikey) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -- OpenAI-compatible (OpenAI, Groq, a local Ollama/vLLM server, etc.) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# Scraper options
# ------------------------------------------------------------------

# Path to the tesseract binary. Leave blank to use the OS default
# (see config.py's default_tesseract_path()).
TESSERACT_CMD=

# Run the browser headless (recommended when this runs on a server
# without a display). Set to "false" to watch the browser locally.
SCRAPER_HEADLESS=true

# ------------------------------------------------------------------
# Web server
# ------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000


TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe